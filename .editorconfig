root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,asmdef,asmref,yml,yaml}]
indent_size = 2

[*.asmdef]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{unity,prefab,asset,mat,anim,controller,meta}]
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

# 第三方代码保持原样，不套用本项目格式
[{Assets/ThirdParty/**,ThirdParty/**,LocalPackages/**,Assets/TextMesh Pro/**,Packages/com.jokerseed.framework.battle/Runtime/LockstepPhysics/Farseer/**,Packages/com.jokerseed.framework.battle/Runtime/LockstepPhysics/Jitter/**,Assets/Generated/**}]
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# 第三方源码（Farseer、TrueSync 接口、KCP）保持原样，它们的编译警告在这里按路径关掉；
# 自研代码在 tests/Framework.Sim.Tests 里开启“警告即错误”，所以不能再用工程级 NoWarn 一起压掉。
[{Packages/com.jokerseed.framework.battle/Runtime/LockstepPhysics/**.cs,Packages/com.jokerseed.framework.battle/Runtime/Lockstep/Core/TrueSync/**.cs,Packages/com.jokerseed.framework.network/Runtime/ThirdParty/**.cs}]
dotnet_diagnostic.CS0067.severity = none
dotnet_diagnostic.CS0162.severity = none
dotnet_diagnostic.CS0168.severity = none
dotnet_diagnostic.CS0169.severity = none
dotnet_diagnostic.CS0219.severity = none
dotnet_diagnostic.CS0414.severity = none
dotnet_diagnostic.CS0618.severity = none
dotnet_diagnostic.CS0649.severity = none

[*.cs]
# 命名
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# 风格
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_namespace_declarations = block_scoped:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
