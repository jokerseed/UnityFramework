<Project Sdk="Microsoft.NET.Sdk">

  <!--
    定点查找表编码工具。读取 Packages/.../FixedMath 下的 Fix64SinLut.cs / Fix64TanLut.cs（旧的十六进制数组或已编码格式均可），
    用 FixedLutCodec 重新编码写回，并打印 SHA-256 供 tests/Framework.Sim.Tests 校验。
    用法：在本目录执行 dotnet run -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)Packages/com.jokerseed.framework.battle/Runtime/FixedMath/FixedLutCodec.cs" Link="FixedLutCodec.cs" />
  </ItemGroup>

</Project>
